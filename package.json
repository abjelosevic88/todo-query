{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "vite:dev": "vite",
    "lint": "eslint resources/js --ext .js,.jsx,.ts,.tsx --ignore-path .gitignore --fix",
    "build-run": "tsc && vite build && vite build --ssr && php artisan inertia:start-ssr",
    "php:serve": "php artisan serve",
    "php:serve-test": "php artisan serve --env=testing",
    "php:pail": "php artisan pail",
    "php:reverb": "php artisan reverb:start",
    "start:dev": "concurrently -k -p \"[{name}]\" -c \"blue.bold,green.bold,red.bold,yellow.bold,white.bold\" \"npm:php:serve\" \"npm:php:pail\" \"npm:php:reverb\" \"npm:vite:dev\"",
    "start:test": "concurrently -k -p \"[{name}]\" -c \"blue.bold,green.bold,red.bold\" \"npm:php:serve-test\" \"npm:php:reverb\" \"npm:vite:dev\""
  },
  "devDependencies": {
    "@headlessui/react": "^2.0.0",
    "@inertiajs/react": "^2.0.0",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/postcss": "^4.1.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^18.13.0",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.10",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-react": "^4.2.0",
    "axios": "^1.8.2",
    "concurrently": "^9.0.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "laravel-echo": "^2.0.2",
    "laravel-vite-plugin": "^1.2.0",
    "postcss": "^8.4.31",
    "prettier": "^3.3.0",
    "prettier-plugin-organize-imports": "^4.0.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "pusher-js": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.0.2",
    "vite": "^6.2.4"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@tanstack/react-query": "^5.74.4",
    "@tanstack/react-query-devtools": "^5.74.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.488.0",
    "react-hook-form": "^7.55.0",
    "tailwind-merge": "^3.2.0",
    "tw-animate-css": "^1.2.5",
    "zod": "^3.24.3"
  }
}
